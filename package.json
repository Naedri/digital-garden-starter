{
  "name": "digital-garden-template",
  "version": "1.0.0",
  "description": "🌱 Fork this seed and grow your own digital garden of ideas.",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "test": "npm run test:size && npm run test:link",
    "test:size": "size-limit",
    "test:link": "lychee vitepress/**/*.md --base ./vitepress/public",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naedri/digital-garden-template.git"
  },
  "keywords": [
    "digital-garden",
    "template"
  ],
  "author": "Adrien JALLAIS",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Naedri/digital-garden-template/issues"
  },
  "homepage": "https://github.com/Naedri/digital-garden-template#readme",
  "devDependencies": {
    "@size-limit/file": "^12.0.1",
    "prettier": "^3.8.1",
    "size-limit": "^12.0.1",
    "vitepress": "^2.0.0-alpha.16"
  }
}
